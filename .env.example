# Required in every environment. Generate a long, random, unique value.
DJANGO_SECRET_KEY=replace-with-a-random-secret-key-at-least-50-characters-long

# Use True only for local development.
DJANGO_DEBUG=False

# Comma-separated host names accepted by this deployment.
DJANGO_ALLOWED_HOSTS=reservations.example.edu

# Comma-separated HTTPS origins allowed to submit CSRF-protected requests.
DJANGO_CSRF_TRUSTED_ORIGINS=https://reservations.example.edu

# Secure production defaults are enabled automatically when DEBUG=False.
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=False

# Enable only when the application is behind a trusted reverse proxy that
# sets X-Forwarded-Proto correctly.
DJANGO_TRUST_PROXY_HEADERS=False

# Production SMTP delivery. Credentials remain outside source control.
DJANGO_EMAIL_HOST=smtp.example.edu
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=True
DJANGO_EMAIL_USE_SSL=False
DJANGO_EMAIL_TIMEOUT=10

# Required only when running `python manage.py seed_demo` without the
# `--password` option. Never commit an actual demo password.
DEMO_ACCOUNT_PASSWORD=
